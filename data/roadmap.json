 {"id":"s0","title":"Prerequisites","duration":"1–2 weeks","topics":[
  {"slug":"choose-a-language","title":"Choose a language","level":"Beginner","hours":2,"description":"Pick one programming language and use it consistently while learning DSA. The ideas transfer between languages; fluency in one keeps syntax from getting in the way.","concepts":["Python, Java, or C++ are all good choices","Learn basic input and output","Know how to create arrays, maps, sets, and queues","Use the language you can write most comfortably"],"complexity":[],"resources":[{"label":"NeetCode learning resources","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks tutorials","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Two Sum","Contains Duplicate","Valid Anagram","Fibonacci Number","Reverse String"]},
  {"slug":"basic-syntax","title":"Basic syntax & data types","level":"Beginner","hours":4,"description":"Get comfortable with variables, primitive types, collections, and writing small programs. You only need enough syntax to express an algorithm clearly.","concepts":["Variables and types","Arrays and strings","Maps and sets","Functions and return values","Input and output"],"complexity":[],"resources":[{"label":"GeeksforGeeks programming tutorials","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"YouTube programming lessons","type":"Video","url":"https://www.youtube.com"}],"problems":["Running Sum of 1d Array","Richest Customer Wealth","Concatenation of Array","Build Array from Permutation","Shuffle the Array"]},
  {"slug":"loops-and-conditionals","title":"Loops & conditionals","level":"Beginner","hours":3,"description":"Loops repeat work and conditionals choose what happens next. Together they form the building blocks of almost every algorithm.","concepts":["if / else","for loops","while loops","Nested loops","Loop invariants"],"complexity":[{"operation":"Single loop over n items","time":"O(n)","space":"O(1)"},{"operation":"Nested loops over n items","time":"O(n²)","space":"O(1)"}],"resources":[{"label":"GeeksforGeeks programming tutorials","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"Visualgo algorithm visualizations","type":"Visualizer","url":"https://visualgo.net"}],"problems":["Fizz Buzz","Number of Steps to Reduce a Number to Zero","Find Numbers with Even Number of Digits","Count Items Matching a Rule","Sqrt(x)"]},
  {"slug":"functions","title":"Functions","level":"Beginner","hours":2,"description":"Functions package logic into reusable pieces. They also make recursive algorithms possible by letting a function call itself.","concepts":["Parameters and return values","Scope","Pure functions","Breaking problems into helpers","Call stack basics"],"complexity":[],"resources":[{"label":"GeeksforGeeks tutorials","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"YouTube programming lessons","type":"Video","url":"https://www.youtube.com"}],"problems":["Power of Two","Palindrome Number","Valid Palindrome","Add Digits","Climbing Stairs"]},
  {"slug":"big-o","title":"Big-O: time & space complexity","level":"Beginner","hours":5,"description":"Big-O describes how an algorithm's resource use grows as input grows. It helps you compare approaches and recognize when a solution will scale.","concepts":["Worst-case growth","Constant, logarithmic, linear, quadratic","Auxiliary space","Trade-offs between time and memory","Ignore constants and lower-order terms"],"complexity":[{"operation":"Array index access","time":"O(1)","space":"O(1)"},{"operation":"Binary search","time":"O(log n)","space":"O(1)"},{"operation":"Sorting comparison-based data","time":"O(n log n)","space":"Varies"},{"operation":"Nested full scans","time":"O(n²)","space":"O(1)"}],"resources":[{"label":"Big-O reference and algorithms","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"Visualgo algorithm visualizations","type":"Visualizer","url":"https://visualgo.net"}],"problems":["Two Sum","Contains Duplicate","Binary Search","Maximum Subarray","Product of Array Except Self"]}
 ]},
 {"id":"s1","title":"Foundations","duration":"3–5 weeks","topics":[
  {"slug":"arrays","title":"Arrays","level":"Beginner","hours":6,"description":"Arrays store values in order and provide fast access by index. They appear in nearly every interview problem and are a natural starting point for learning patterns.","concepts":["Indexing and traversal","In-place updates","Subarrays","Sorting and searching","Space-time trade-offs"],"complexity":[{"operation":"Index access","time":"O(1)","space":"O(1)"},{"operation":"Search unsorted","time":"O(n)","space":"O(1)"},{"operation":"Insert/delete middle","time":"O(n)","space":"O(1)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks arrays","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Two Sum","Best Time to Buy and Sell Stock","Contains Duplicate","Product of Array Except Self","Maximum Subarray","Merge Sorted Array"]},
  {"slug":"strings","title":"Strings","level":"Beginner","hours":5,"description":"Strings are sequences of characters. Most string questions become easier when you combine careful indexing with arrays, maps, or two pointers.","concepts":["Character indexing","Immutability in many languages","Frequency counts","Palindromes","Substring vs subsequence"],"complexity":[{"operation":"Read character","time":"O(1)","space":"O(1)"},{"operation":"Build concatenated string","time":"O(n)","space":"O(n)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks strings","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Valid Anagram","Valid Palindrome","Longest Common Prefix","Longest Substring Without Repeating Characters","Group Anagrams","Longest Palindromic Substring"]},
  {"slug":"hashing","title":"Hashing: maps & sets","level":"Beginner","hours":5,"description":"Hash maps and sets help you find, count, and group values quickly. They often turn a repeated search into one pass through the data.","concepts":["Hash map key-value pairs","Set membership","Frequency counting","Collision idea","When extra memory saves time"],"complexity":[{"operation":"Average lookup/insert","time":"O(1)","space":"O(n)"},{"operation":"Worst-case lookup","time":"O(n)","space":"O(n)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks hashing","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Two Sum","Contains Duplicate","Valid Anagram","Group Anagrams","Top K Frequent Elements","Longest Consecutive Sequence"]},
  {"slug":"two-pointers","title":"Two Pointers","level":"Beginner","hours":4,"description":"Two pointers track positions in a sequence and move based on what you learn. The pattern is especially useful for sorted arrays and pair searches.","concepts":["Opposite-direction pointers","Fast and slow pointers","Sorted pair search","In-place filtering","Move one pointer based on a condition"],"complexity":[{"operation":"Typical scan","time":"O(n)","space":"O(1)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks two pointers","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Valid Palindrome","Two Sum II - Input Array Is Sorted","3Sum","Container With Most Water","Remove Duplicates from Sorted Array","Trapping Rain Water"]},
  {"slug":"sliding-window","title":"Sliding Window","level":"Intermediate","hours":5,"description":"A sliding window keeps a range of a sequence and updates it as it moves. It can reduce repeated work in contiguous subarray and substring problems.","concepts":["Fixed-size windows","Variable-size windows","Expand and shrink","Window invariants","Counting with a map"],"complexity":[{"operation":"Typical window scan","time":"O(n)","space":"O(k)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks sliding window","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Best Time to Buy and Sell Stock","Longest Substring Without Repeating Characters","Minimum Window Substring","Permutation in String","Sliding Window Maximum","Longest Repeating Character Replacement"]},
  {"slug":"prefix-sum","title":"Prefix Sum","level":"Intermediate","hours":3,"description":"Prefix sums store cumulative totals so range sums can be answered quickly. The same idea works with counts and other associative operations.","concepts":["Cumulative sums","Range sum from two prefixes","Prefix frequency maps","Difference arrays","Inclusive and exclusive boundaries"],"complexity":[{"operation":"Build prefix array","time":"O(n)","space":"O(n)"},{"operation":"Range sum query","time":"O(1)","space":"O(1)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks prefix sum","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Range Sum Query - Immutable","Subarray Sum Equals K","Find Pivot Index","Continuous Subarray Sum","Product of Array Except Self"]}
 ]},
 {"id":"s2","title":"Core Techniques","duration":"4–6 weeks","topics":[
  {"slug":"recursion","title":"Recursion","level":"Intermediate","hours":5,"description":"Recursion solves a problem by solving smaller versions of the same problem. Tracing calls and defining a clear base case are the most important habits.","concepts":["Base case","Recursive step","Call stack","Tree of calls","Memoization preview"],"complexity":[],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks recursion","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Reverse Linked List","Maximum Depth of Binary Tree","Same Tree","Pow(x, n)","Fibonacci Number"]},
  {"slug":"sorting","title":"Sorting","level":"Intermediate","hours":4,"description":"Sorting organizes data so patterns become visible and searches become simpler. Learn the behavior and trade-offs of common sorting algorithms.","concepts":["Comparison sorting","Merge sort","Quick sort","Stable sorting","Custom comparators"],"complexity":[{"operation":"Merge sort","time":"O(n log n)","space":"O(n)"},{"operation":"Quick sort average","time":"O(n log n)","space":"O(log n)"}],"resources":[{"label":"GeeksforGeeks sorting algorithms","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"Visualgo sorting visualizations","type":"Visualizer","url":"https://visualgo.net"}],"problems":["Sort an Array","Merge Intervals","Kth Largest Element in an Array","Sort Colors","Meeting Rooms"]},
  {"slug":"binary-search","title":"Binary Search","level":"Intermediate","hours":5,"description":"Binary search repeatedly halves a sorted search space. It also applies to finding the first valid answer when a condition changes monotonically.","concepts":["Search interval","Midpoint and boundaries","Lower/upper bound","Search on answer","Monotonic predicates"],"complexity":[{"operation":"Search sorted array","time":"O(log n)","space":"O(1)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks binary search","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Binary Search","Search in Rotated Sorted Array","Find Minimum in Rotated Sorted Array","Koko Eating Bananas","Time Based Key-Value Store","Median of Two Sorted Arrays"]},
  {"slug":"linked-list","title":"Linked List","level":"Intermediate","hours":5,"description":"Linked lists connect nodes with references instead of storing them next to each other. They teach pointer manipulation and are common interview building blocks.","concepts":["Singly and doubly linked lists","Dummy head","Fast and slow pointers","Reversing links","Cycle detection"],"complexity":[{"operation":"Access by position","time":"O(n)","space":"O(1)"},{"operation":"Insert at known node","time":"O(1)","space":"O(1)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks linked lists","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Reverse Linked List","Merge Two Sorted Lists","Linked List Cycle","Reorder List","Remove Nth Node From End of List","Add Two Numbers"]},
  {"slug":"stack","title":"Stack","level":"Intermediate","hours":3,"description":"A stack follows last-in, first-out order. It is useful for nested structure, undo operations, and keeping track of unresolved choices.","concepts":["Push and pop","Call stack","Matching brackets","Monotonic stacks","Expression evaluation"],"complexity":[{"operation":"Push/pop/top","time":"O(1)","space":"O(n)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks stack","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Valid Parentheses","Min Stack","Evaluate Reverse Polish Notation","Daily Temperatures","Largest Rectangle in Histogram"]},
  {"slug":"queue","title":"Queue","level":"Intermediate","hours":2,"description":"A queue processes items first-in, first-out. Queues power breadth-first search and fair task scheduling.","concepts":["Enqueue and dequeue","Circular queue","Deque","BFS frontier","Queue implementation"],"complexity":[{"operation":"Enqueue/dequeue","time":"O(1)","space":"O(n)"}],"resources":[{"label":"GeeksforGeeks queue","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"Visualgo data structures","type":"Visualizer","url":"https://visualgo.net"}],"problems":["Implement Queue using Stacks","Design Circular Queue","Number of Recent Calls","Rotting Oranges","Moving Average from Data Stream"]},
  {"slug":"backtracking","title":"Backtracking","level":"Intermediate","hours":6,"description":"Backtracking explores possible choices and undoes them when a path cannot work. It is a systematic way to generate combinations, permutations, and valid boards.","concepts":["Choose, explore, undo","Pruning","Decision tree","Combination vs permutation","Constraint checking"],"complexity":[],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks backtracking","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Subsets","Combination Sum","Permutations","Word Search","Palindrome Partitioning","N-Queens"]}
 ]},
 {"id":"s3","title":"Non-linear Structures","duration":"5–7 weeks","topics":[
  {"slug":"trees","title":"Trees","level":"Intermediate","hours":6,"description":"Trees represent hierarchical relationships. Traversal patterns let you visit nodes in different orders and solve problems about depth and structure.","concepts":["Root, child, leaf","Preorder, inorder, postorder","Level-order traversal","Height and depth","Recursive tree reasoning"],"complexity":[{"operation":"Traverse all nodes","time":"O(n)","space":"O(h)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"Visualgo tree visualizations","type":"Visualizer","url":"https://visualgo.net"}],"problems":["Maximum Depth of Binary Tree","Invert Binary Tree","Same Tree","Subtree of Another Tree","Diameter of Binary Tree","Binary Tree Level Order Traversal"]},
  {"slug":"binary-search-tree","title":"Binary Search Tree","level":"Intermediate","hours":3,"description":"A binary search tree keeps smaller values on one side and larger values on the other. This ordering supports efficient search when the tree stays balanced.","concepts":["BST ordering invariant","Search, insert, delete","Inorder traversal","Balanced vs skewed trees","Validate bounds"],"complexity":[{"operation":"Search/insert average","time":"O(log n)","space":"O(h)"},{"operation":"Search/insert worst","time":"O(n)","space":"O(h)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks BST","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Validate Binary Search Tree","Kth Smallest Element in a BST","Lowest Common Ancestor of a Binary Search Tree","Insert into a Binary Search Tree","Delete Node in a BST"]},
  {"slug":"heap-priority-queue","title":"Heap & Priority Queue","level":"Intermediate","hours":4,"description":"A heap keeps the highest- or lowest-priority item easy to retrieve. Priority queues are useful when you repeatedly need the next best candidate.","concepts":["Min-heap and max-heap","Heapify","Push and pop","Top K pattern","Merge streams"],"complexity":[{"operation":"Peek","time":"O(1)","space":"O(1)"},{"operation":"Insert/remove top","time":"O(log n)","space":"O(n)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks heap","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Kth Largest Element in an Array","Top K Frequent Elements","Last Stone Weight","Find Median from Data Stream","Merge k Sorted Lists"]},
  {"slug":"trie","title":"Trie","level":"Advanced","hours":3,"description":"A trie stores words by shared prefixes. It can answer prefix questions efficiently when many strings share the same beginnings.","concepts":["Prefix tree nodes","Insert and search","Word prefix search","Space trade-off","Dictionary of words"],"complexity":[{"operation":"Search word of length L","time":"O(L)","space":"O(total characters)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks trie","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Implement Trie (Prefix Tree)","Design Add and Search Words Data Structure","Word Search II","Replace Words","Longest Word in Dictionary"]},
  {"slug":"graphs","title":"Graphs: BFS, DFS & paths","level":"Intermediate","hours":9,"description":"Graphs model connections between things. BFS and DFS explore them, while topological ordering and shortest-path algorithms solve richer route and dependency questions.","concepts":["Adjacency list and matrix","BFS and DFS","Visited set","Topological sort","Dijkstra shortest path"],"complexity":[{"operation":"BFS/DFS adjacency list","time":"O(V + E)","space":"O(V + E)"},{"operation":"Dijkstra with heap","time":"O((V + E) log V)","space":"O(V + E)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"CP-Algorithms graph reference","type":"Article","url":"https://cp-algorithms.com"}],"problems":["Number of Islands","Clone Graph","Course Schedule","Pacific Atlantic Water Flow","Network Delay Time","Word Ladder"]}
 ]},
 {"id":"s4","title":"Optimization","duration":"4–6 weeks","topics":[
  {"slug":"greedy","title":"Greedy Algorithms","level":"Intermediate","hours":4,"description":"Greedy algorithms make a locally best choice at each step. The key challenge is proving that those choices lead to a global optimum.","concepts":["Sort by a useful key","Exchange argument intuition","Interval scheduling","When greedy fails","Proof before implementation"],"complexity":[],"resources":[{"label":"GeeksforGeeks greedy algorithms","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"CP-Algorithms","type":"Article","url":"https://cp-algorithms.com"}],"problems":["Jump Game","Gas Station","Assign Cookies","Non-overlapping Intervals","Partition Labels"]},
  {"slug":"dynamic-programming","title":"Dynamic Programming","level":"Advanced","hours":12,"description":"Dynamic programming saves answers to overlapping subproblems. Start by defining the state and recurrence, then choose memoization or a bottom-up table.","concepts":["State definition","Transition / recurrence","Base cases","Memoization vs tabulation","1D, 2D, knapsack, LIS, and grid patterns"],"complexity":[{"operation":"Typical table DP","time":"O(states × transitions)","space":"O(states)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"CP-Algorithms dynamic programming","type":"Article","url":"https://cp-algorithms.com"}],"problems":["Climbing Stairs","House Robber","Coin Change","Longest Increasing Subsequence","Longest Common Subsequence","Unique Paths","Word Break","Partition Equal Subset Sum"]},
  {"slug":"bit-manipulation","title":"Bit Manipulation","level":"Advanced","hours":3,"description":"Bit operations work directly with a number's binary representation. They can express compact flags and solve parity or subset problems elegantly.","concepts":["AND, OR, XOR, NOT","Left and right shifts","Masking a bit","XOR cancellation","Counting set bits"],"complexity":[{"operation":"Bitwise operation","time":"O(1)","space":"O(1)"}],"resources":[{"label":"GeeksforGeeks bit manipulation","type":"Article","url":"https://www.geeksforgeeks.org"},{"label":"CP-Algorithms","type":"Article","url":"https://cp-algorithms.com"}],"problems":["Single Number","Number of 1 Bits","Counting Bits","Missing Number","Reverse Bits","Sum of Two Integers"]}
 ]},
 {"id":"s5","title":"Advanced","duration":"3–5 weeks","topics":[
  {"slug":"union-find","title":"Union Find (DSU)","level":"Advanced","hours":4,"description":"Disjoint Set Union tracks connected groups while they are merged. Path compression and union by rank make operations nearly constant time in practice.","concepts":["Find representative","Union groups","Path compression","Union by size/rank","Connectivity queries"],"complexity":[{"operation":"Find/union amortized","time":"O(α(n))","space":"O(n)"}],"resources":[{"label":"CP-Algorithms DSU","type":"Article","url":"https://cp-algorithms.com"},{"label":"GeeksforGeeks DSU","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Number of Connected Components in an Undirected Graph","Redundant Connection","Accounts Merge","Most Stones Removed with Same Row or Column","Satisfiability of Equality Equations"]},
  {"slug":"segment-tree","title":"Segment Tree","level":"Advanced","hours":5,"description":"A segment tree stores summaries for ranges and supports efficient range queries and updates. Learn it after prefix sums and recursion feel comfortable.","concepts":["Build tree over intervals","Range query","Point update","Lazy propagation idea","Combine node summaries"],"complexity":[{"operation":"Build","time":"O(n)","space":"O(n)"},{"operation":"Query/update","time":"O(log n)","space":"O(1) extra"}],"resources":[{"label":"CP-Algorithms segment tree","type":"Article","url":"https://cp-algorithms.com"},{"label":"GeeksforGeeks segment tree","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Range Sum Query - Mutable","Count of Smaller Numbers After Self","The Skyline Problem","Falling Squares","My Calendar III"]},
  {"slug":"monotonic-stack","title":"Monotonic Stack","level":"Advanced","hours":3,"description":"A monotonic stack keeps values in sorted order so each item can find its next greater or smaller neighbor in linear time.","concepts":["Increasing and decreasing stacks","Next greater element","Pop while invariant breaks","Amortized analysis","Histogram ranges"],"complexity":[{"operation":"One pass with stack","time":"O(n)","space":"O(n)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks monotonic stack","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Daily Temperatures","Next Greater Element I","Next Greater Element II","Largest Rectangle in Histogram","Sum of Subarray Minimums"]},
  {"slug":"intervals","title":"Intervals","level":"Intermediate","hours":4,"description":"Interval problems are about ranges on a line. Sorting by start or end often reveals how to merge, schedule, or compare them.","concepts":["Sort by start/end","Overlap conditions","Merge ranges","Sweep line intuition","Meeting room scheduling"],"complexity":[{"operation":"Sort and scan","time":"O(n log n)","space":"O(n)"}],"resources":[{"label":"NeetCode roadmap","type":"Video","url":"https://neetcode.io"},{"label":"GeeksforGeeks intervals","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Merge Intervals","Insert Interval","Non-overlapping Intervals","Meeting Rooms","Meeting Rooms II","Minimum Number of Arrows to Burst Balloons"]},
  {"slug":"advanced-graphs","title":"Advanced Graphs","level":"Advanced","hours":8,"description":"Advanced graph topics build on traversal and shortest paths, adding spanning trees, strongly connected components, and specialized path algorithms.","concepts":["Minimum spanning tree","Kruskal and Prim","Bellman-Ford","Floyd-Warshall","Strongly connected components"],"complexity":[{"operation":"Kruskal MST","time":"O(E log E)","space":"O(V + E)"},{"operation":"Bellman-Ford","time":"O(VE)","space":"O(V)"}],"resources":[{"label":"CP-Algorithms graph reference","type":"Article","url":"https://cp-algorithms.com"},{"label":"GeeksforGeeks graph algorithms","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Min Cost to Connect All Points","Path With Minimum Effort","Cheapest Flights Within K Stops","Critical Connections in a Network","Find Critical and Pseudo-Critical Edges in Minimum Spanning Tree"]}
 ]},
