  {"slug":"patterns-revision","title":"Patterns revision","level":"Intermediate","hours":8,"description":"Consolidate what you learned by identifying the pattern before coding. Revisit missed problems after a delay instead of memorizing solutions.","concepts":["Name the pattern first","Explain brute force then optimize","Keep a mistake log","Re-solve after 1, 7, and 30 days","Practice clear complexity analysis"],"complexity":[],"resources":[{"label":"NeetCode practice roadmap","type":"Video","url":"https://neetcode.io"},{"label":"LeetCode practice","type":"Practice","url":"https://leetcode.com"}],"problems":["Two Sum","Longest Substring Without Repeating Characters","3Sum","Number of Islands","Course Schedule","Coin Change"]},
  {"slug":"mock-interview-plan","title":"Mock interview plan","level":"Advanced","hours":6,"description":"Mock interviews turn knowledge into communication under time pressure. Practice clarifying the prompt, narrating trade-offs, and testing edge cases aloud.","concepts":["Clarify inputs and constraints","Think aloud","Start with a correct approach","Test edge cases","Reflect after each session"],"complexity":[],"resources":[{"label":"LeetCode interview practice","type":"Practice","url":"https://leetcode.com"},{"label":"NeetCode interview prep","type":"Video","url":"https://neetcode.io"}],"problems":["Merge Two Sorted Lists","Valid Parentheses","Binary Tree Level Order Traversal","Meeting Rooms II","LRU Cache"]},
  {"slug":"company-strategy","title":"Company-wise strategy","level":"Advanced","hours":4,"description":"Use company-tagged questions as a final prioritization layer after you know the core patterns. Focus on role expectations and consistent practice, not guessing exact questions.","concepts":["Review role and level expectations","Use recent public question lists cautiously","Prioritize weak patterns","Mix unseen questions with review","Prepare behavioral examples too"],"complexity":[],"resources":[{"label":"LeetCode interview study plans","type":"Practice","url":"https://leetcode.com"},{"label":"GeeksforGeeks interview preparation","type":"Article","url":"https://www.geeksforgeeks.org"}],"problems":["Two Sum","LRU Cache","Merge Intervals","Word Ladder","Median of Two Sorted Arrays"]}
